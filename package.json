{
  "name": "bobi",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "workspaces": ["packages/*"],
  "scripts": {
    "postinstall": "bun scripts/link-upstream.ts",
    "test": "bun test ./packages ./tests",
    "test:coverage": "bun test --coverage ./packages ./tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "browser:install": "bun packages/browser/node_modules/playwright-core/cli.js install chromium-headless-shell"
  },
  "devDependencies": {
    "@bobi/config": "workspace:*",
    "@bobi/core": "workspace:*",
    "@bobi/mock-model": "workspace:*",
    "@bobi/shell": "workspace:*",
    "@types/bun": "1.4.0",
    "typescript": "5.8.2"
  }
}
