{
  "name": "bobi-chat",
  "displayName": "Bobi",
  "description": "Chat with Bobi, your on-prem AI development partner",
  "version": "1.1.0",
  "publisher": "bobi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Bobi asks for its own project trust before it uses a project's configuration. The command that starts Bobi can only be set in user settings.",
      "restrictedConfigurations": [
        "bobi.command"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bobi",
          "title": "Bobi",
          "icon": "media/bobi.svg"
        }
      ]
    },
    "views": {
      "bobi": [
        {
          "type": "webview",
          "id": "bobi.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "bobi.newSession",
        "title": "Bobi: New Chat"
      },
      {
        "command": "bobi.selectMode",
        "title": "Bobi: Select Mode"
      },
      {
        "command": "bobi.undo",
        "title": "Bobi: Undo Last Changes"
      },
      {
        "command": "bobi.restartServer",
        "title": "Bobi: Restart Server"
      },
      {
        "command": "bobi.literate",
        "title": "Bobi: Implement Instructions Here",
        "icon": "$(sparkle)"
      },
      {
        "command": "bobi.generateCommitMessage",
        "title": "Bobi: Generate Commit Message",
        "icon": "$(sparkle)"
      }
    ],
    "configuration": {
      "title": "Bobi",
      "properties": {
        "bobi.command": {
          "type": "array",
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Command that starts Bobi (default: `bobi` on PATH or ~/.local/bin/bobi). User settings only: a value in a workspace's .vscode/settings.json is ignored."
        },
        "bobi.includeOpenTabs": {
          "type": "boolean",
          "default": true,
          "description": "Send the open editors and the current selection as context."
        },
        "bobi.tips.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Code tips: mark complex functions and anti-patterns while editing (local analysis, no model call). Thresholds: tips in the Bobi config."
        },
        "bobi.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Inline code suggestions from Bobi. They appear only when an autocomplete model is set in the Bobi config (autocomplete.model)."
        }
      }
    },
    "configurationDefaults": {
      "chat.disableAIFeatures": true
    },
    "keybindings": [
      {
        "command": "bobi.literate",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "bobi.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bobi.literate",
          "group": "bobi"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --target=node --format=cjs --external vscode --outfile dist/extension.js"
  },
  "devDependencies": {
    "diff": "8.0.4",
    "@types/vscode": "1.100.0",
    "@bobi/server": "workspace:*",
    "@bobi/config": "workspace:*",
    "@bobi/mock-model": "workspace:*"
  }
}
