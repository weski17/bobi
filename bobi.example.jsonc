// Example Bobi configuration. Copy to ~/.bobi/config.jsonc (personal) or <project>/.bobi/config.jsonc (team, versioned).
// Secrets are never allowed here: the API key is read from the environment variable named in model.apiKeyEnv.
{
  "model": {
    // OpenAI-compatible gateway (LiteLLM default port). vLLM and Ollama also work: http://host:8000/v1, http://host:11434/v1
    "baseURL": "http://localhost:4000/v1",
    "protocol": "openai",            // or "anthropic" (Anthropic-compatible endpoint, not yet tested)
    "apiKeyEnv": "BOBI_MODEL_API_KEY",
    "default": "default",            // model id as served by the gateway
    "models": []                     // further model ids that modes may use
  },
  // Model per mode (modes themselves arrive in Phase 2)
  "modes": {
    // "plan": { "model": "large-model" },
    // "code": { "model": "small-model" }
  },
  // Explicit auto-approvals. Without them every write, shell command and network access asks.
  "autoApprove": [
    // { "action": "shell", "resource": "npm test" },   (a redirect into a file, e.g. "> out.txt", still asks)
    // { "action": "edit", "resource": "docs/*", "modes": ["code"] }
  ],
  "telemetry": {
    // OTLP/HTTP endpoint of an OpenTelemetry collector or Langfuse; also settable via OTEL_EXPORTER_OTLP_ENDPOINT
    // "otlpEndpoint": "http://localhost:4318"
    // Local audit log ~/.bobi/audit/<date>.jsonl for `bobi audit` reports (default true)
    // "auditLog": true
  },
  "checkpoints": { "enabled": true },
  // Session titles: "model" asks the model after the first message (one extra request per session),
  // "local" derives the title from the first message without a model call (also BOBI_SESSION_TITLES).
  // "sessions": { "titles": "local" },
  // Inline code suggestions in Bobi IDE (fill-in-the-middle via <baseURL>/completions). Off until a model is set;
  // the model must be model.default or listed in model.models.
  // "autocomplete": { "model": "qwen2.5-coder", "maxTokens": 128 },
  // A2A. "enabled" (global config or BOBI_A2A=1 only): other agents may send read-only tasks to `bobi serve`;
  // agent card at /.well-known/agent-card.json, JSON-RPC at /a2a (bearer token BOBI_A2A_TOKEN, ≥ 24 characters, valid only there). "agents": remote agents
  // Bobi may ask with the a2a tool (Advanced mode, always confirmed); credentials only as ${ENV_VAR}.
  "a2a": {
    "enabled": false,
    "agents": {
      // "tickets": { "url": "https://tickets.intranet", "headers": { "Authorization": "Bearer ${TICKETS_A2A_TOKEN}" }, "description": "ticket system" }
    }
  },
  // MCP servers. Built in (Advanced mode): "code-graph", "cobol", and "zowe" when a Zowe connection is
  // configured (zowe.config.json or ZOWE_OPT_HOST/USER/PASSWORD; datasets limited by BOBI_ZOWE_DATASETS).
  // Credentials only as ${ENV_VAR}; project servers are used only in trusted projects.
  "mcp": {
    "servers": {
      // "jira": { "type": "remote", "url": "https://jira.intranet/mcp", "headers": { "Authorization": "Bearer ${JIRA_TOKEN}" } },
      // "docs": { "type": "local", "command": ["bunx", "my-docs-mcp"], "env": { "DOCS_TOKEN": "${DOCS_TOKEN}" } }
    }
  }
}
